# Google News RSS and public Bluesky reads need no API key.
PORT=8787
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
FEED_DB_PATH=server/data/tweetmint.sqlite
# Set to 1 behind production HTTPS. Set APP_ORIGIN to your public site origin.
COOKIE_SECURE=0
# Enable direct publisher feeds only after obtaining redistribution permission.
# Accepted IDs: coindesk,cointelegraph,decrypt. Empty by default.
LICENSED_RSS_SOURCES=
# Server verification always uses mainnet-beta; keep private RPC credentials out of VITE_.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_RPC_URL=
VITE_SOLANA_NETWORK=mainnet-beta
VITE_PUMPFUN_CREATE_URL=https://pump.fun/create
